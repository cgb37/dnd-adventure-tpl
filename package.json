{
  "name": "dnd-adventure-tpl",
  "version": "0.1.1",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "conventional-changelog-cli": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cgb37/dnd-adventure-tpl.git"
  },
  "scripts": {
    "test:ui": "docker compose up -d --build api && docker compose run --rm --build jekyll bundle exec jekyll build --destination _site-ui && playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "bash ./scripts/release.sh",
    "release:major": "bash ./scripts/release.sh major",
    "release:minor": "bash ./scripts/release.sh minor",
    "release:patch": "bash ./scripts/release.sh patch",
    "release:set": "bash ./scripts/release.sh set",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:up:detached": "docker compose up -d",
    "docker:up:build": "docker compose up --build",
    "docker:stop": "docker compose down",
    "docker:restart": "docker compose down && docker compose up",
    "docker:restart:build": "docker compose down && docker compose up --build",
    "docker:restart:clean": "rm -f .jekyll-metadata && rm -rf _site && npm run docker:restart"
  }
}
